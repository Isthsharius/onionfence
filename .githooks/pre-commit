#!/bin/sh
# Перед коммитом изменений torproxy прогоняет офлайн-тесты (живой Tor не запускается).
# Пропустить один раз: git commit --no-verify

git diff --cached --name-only | grep -qE '^(install\.sh|functions/torproxy\.fish|bin/torproxy|completions/torproxy\.fish|tests/torproxy/)' || exit 0

echo "torproxy: запускаю тесты (около 40 секунд)…"
log=$(mktemp)
if fish tests/torproxy/run.fish --offline >"$log" 2>&1; then
    tail -n 1 "$log"
    rm -f "$log"
else
    cat "$log"
    rm -f "$log"
    echo
    echo "Коммит остановлен: тесты torproxy не прошли (пропустить: git commit --no-verify)"
    exit 1
fi
