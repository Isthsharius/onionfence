#!/bin/sh
# Перед коммитом изменений onionfence прогоняет офлайн-тесты (живой Tor не запускается).
# Пропустить один раз: git commit --no-verify

git diff --cached --name-only | grep -qE '^(install\.sh|functions/onionfence\.fish|bin/onionfence|completions/onionfence\.fish|tests/onionfence/)' || exit 0

echo "onionfence: запускаю тесты (около 40 секунд)…"
log=$(mktemp)
if fish tests/onionfence/run.fish --offline >"$log" 2>&1; then
    tail -n 1 "$log"
    rm -f "$log"
else
    cat "$log"
    rm -f "$log"
    echo
    echo "Коммит остановлен: тесты onionfence не прошли (пропустить: git commit --no-verify)"
    exit 1
fi
