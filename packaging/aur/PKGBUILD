# Maintainer: Isthsharius <217949973+Isthsharius@users.noreply.github.com>
pkgname=onionfence
pkgver=0.3.0
pkgrel=1
pkgdesc='Route all system traffic through Tor with one fish command (nftables, bridges, TUI menu)'
arch=('any')
url='https://github.com/Isthsharius/onionfence'
license=('GPL-3.0-or-later')
depends=('fish' 'tor' 'nftables' 'sudo' 'systemd' 'curl' 'jq' 'socat' 'iproute2' 'util-linux')
optdepends=(
  'fzf: interactive menu with arrow keys'
  'lyrebird-proxy: Tor bridges (obfs4, webtunnel, snowflake)'
  'torbrowser-launcher: onionfence browser'
  'mat2: onionfence clean'
  'networkmanager: onionfence hide'
  'less: scrolling in onionfence guide'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('a05f3437f5ad14fdc59a51b607fd225c2caad377079ff4747926299d4ccee39e')

check() {
  cd "$pkgname-$pkgver"
  fish --no-config -n functions/onionfence.fish
  fish --no-config -n bin/onionfence
  fish --no-config -n completions/onionfence.fish
  fish --no-config -c "source functions/onionfence.fish; onionfence version" | grep -q "onionfence $pkgver"
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm644 functions/onionfence.fish "$pkgdir/usr/share/fish/vendor_functions.d/onionfence.fish"
  install -Dm644 completions/onionfence.fish "$pkgdir/usr/share/fish/vendor_completions.d/onionfence.fish"
  install -Dm755 bin/onionfence "$pkgdir/usr/bin/onionfence"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 INSTALL.md "$pkgdir/usr/share/doc/$pkgname/INSTALL.md"
}
